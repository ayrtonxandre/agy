        <mxCell id="card_c3_eng" value="&lt;div&gt;&lt;div style=&quot;display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;&quot;&gt;&lt;span style=&quot;font-size: 15px; font-weight: 800; color: #047857;&quot;&gt;🏃 Engine &amp;amp; Conditioning Tab&lt;/span&gt;&lt;span style=&quot;font-size: 10px; background: #D1FAE5; color: #065F46; font-weight: 700; padding: 2px 6px; border-radius: 4px;&quot;&gt;PACING&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #475569; font-weight: 600; margin-bottom: 6px;&quot;&gt;Running Paces &amp;amp; Work-Rate Sustainability&lt;/div&gt;&lt;div style=&quot;font-size: 11.5px; color: #334155; line-height: 1.55;&quot;&gt;• &lt;b&gt;Critical Speed Zones:&lt;/b&gt; Exact paces for intervals vs. threshold&lt;br/&gt;• &lt;b&gt;CrossFit Stamina Retention:&lt;/b&gt; Pace preservation across WODs&lt;br/&gt;• &lt;b&gt;VO2Max Tracking:&lt;/b&gt; 55.0 ml/kg/min aerobic fitness score&lt;br/&gt;• &lt;b&gt;Ergometer Benchmarks:&lt;/b&gt; Row, Ski, and Bike power metrics&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;spacingBottom=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
