# ==============================================================================
# ATHX 2027 / AGY — Environment Variables Configuration
# ==============================================================================

# Root directory for docker container volumes on the host server
DOCKER_ROOT=/home/user/docker

# Host port mapping for AGY on the server (container listens on 8080)
AGY_HOST_PORT=8095

# Timezone
TZ=Europe/Paris

# Application internal port
PORT=8080

# Optional: Health Auto Export MCP Token (for iOS automation webhook security)
HAE_MCP_TOKEN=your_mcp_secret_token_here

# Optional: Automatic background sync interval in hours (e.g. 6). Set to 0 to disable.
SYNC_INTERVAL_HOURS=6
