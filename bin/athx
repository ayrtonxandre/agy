    if in_use:
        pid_str = f"(PID: {pid})" if pid else ""
        print(f"  • Server Status    : {green}● ONLINE{reset} {gray}{pid_str}{reset}")
    else:
        print(f"  • Server Status    : {yellow}○ OFFLINE{reset} {gray}(start with: athx serve -d){reset}")
