def handle_health_command(agy_dir: Path, venv_py: Path, sub_args: list[str]):
    """Apple Health setup guide and payload inspector."""
    gold = TerminalUI.GOLD
    cyan = TerminalUI.CYAN
    green = TerminalUI.GREEN
    yellow = TerminalUI.YELLOW
    gray = TerminalUI.GRAY
    bold = TerminalUI.BOLD
    reset = TerminalUI.RESET

    parser = argparse.ArgumentParser(prog="athx health", description="Apple Health setup guide and payload inspector")
    parser.add_argument("-r", "--reingest", action="store_true", help="Re-ingest last_payload.json and rebuild datasets")
    parser.add_argument("--json", action="store_true", help="Print raw last_payload.json")
    args = parser.parse_args(sub_args)

    orch_py = agy_dir / "orchestrator.py"
    last_payload = agy_dir / "last_payload.json"

    # Re-ingest flag
    if args.reingest:
        if not last_payload.exists():
            print(f"\n{yellow}⚠️ No last_payload.json found to re-ingest.{reset}\n")
            return
        print(f"\n🔄 Re-ingesting {last_payload.name} through ATHX Orchestrator...")
        subprocess.run([str(venv_py), str(orch_py), "ingest", str(last_payload)], cwd=str(agy_dir))
        return

    # Raw JSON dump
    if args.json:
        if last_payload.exists():
            print(last_payload.read_text(encoding="utf-8"))
        else:
            print("{}\n# No payload received yet")
        return

    port = 8080
    net = get_network_endpoints(port)
    in_use = is_port_in_use(port)

    print(f"\n{gold}{bold}🍏 ATHX 2027 • Apple Health Automated Webhook Setup{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")

    print(f"  {bold}1. Health Auto Export App Configuration on iPhone:{reset}")
    print(f"     • App to install   : {bold}Health Auto Export{reset} (by Healthy Apps)")
    print(f"     • Mode             : {bold}Automated Exports / REST API{reset}")
    print(f"     • HTTP Method      : {cyan}POST{reset}")
    print(f"     • Primary Endpoint : {cyan}{bold}{net['webhook_mdns']}{reset}")
    print(f"     • LAN IP Endpoint  : {cyan}{net['webhook_lan']}{reset}")
    print(f"     • HTTP Headers     : {bold}Content-Type: application/json{reset}")
    print(f"     • Export Cadence   : {bold}Every 15-30 min{reset} + On Background App Refresh")
    print(f"     • Export Format    : {bold}JSON{reset}")
    print()

    print(f"  {bold}2. Required Metrics Checklist in Health Auto Export:{reset}")
    print(f"     {green}✔{reset} {bold}Activity{reset}   : Active Energy, Resting Energy, Steps, Walking+Running Distance, Flights")
    print(f"     {green}✔{reset} {bold}Heart{reset}      : Heart Rate, Resting Heart Rate, Heart Rate Variability (SDNN), VO2 Max")
    print(f"     {green}✔{reset} {bold}Body Comp{reset}  : Weight (Body Mass), Body Fat %, Lean Body Mass, BMI")
    print(f"     {green}✔{reset} {bold}Sleep{reset}      : Sleep Analysis (Core, Deep, REM, Awake, In Bed)")
    print(f"     {green}✔{reset} {bold}Nutrition{reset}  : Dietary Energy, Protein, Carbohydrates, Total Fat, Water")
    print(f"     {green}✔{reset} {bold}Mobility{reset}   : Walking Speed, Step Length, Double Support %, Walking Asymmetry")
    print(f"     {green}✔{reset} {bold}Workouts{reset}   : All Workouts (Export Workouts toggle enabled)")
    print()

    print(f"  {bold}3. Webhook Daemon Status:{reset}")
    if in_use:
        print(f"     • Server Status    : {green}● ACTIVE & LISTENING on port {port}{reset}")
    else:
        print(f"     • Server Status    : {yellow}○ OFFLINE{reset} {gray}(start it with: athx serve -d){reset}")
    print()

    # Payload summary
    print(f"  {bold}4. Latest Received Webhook Payload:{reset}")
    if last_payload.exists():
        try:
            mtime = datetime.fromtimestamp(last_payload.stat().st_mtime).strftime("%Y-%m-%d %H:%M:%S")
            data = json.loads(last_payload.read_text(encoding="utf-8"))
            raw_metrics = data.get("data", data).get("metrics", [])
            metric_names = []
            if isinstance(raw_metrics, list):
                for m in raw_metrics:
                    name = m.get("name")
                    if name:
                        metric_names.append(name)
            elif isinstance(raw_metrics, dict):
                metric_names = list(raw_metrics.keys())

            print(f"     • Received at      : {green}{mtime}{reset}")
            print(f"     • File Size        : {last_payload.stat().st_size / 1024:.1f} KB")
            print(f"     • Metrics Count    : {len(metric_names)} metrics ({', '.join(metric_names[:5])}...)")
            print(f"     • Re-ingest        : run {cyan}athx health --reingest{reset} to reprocess")
        except Exception as e:
            print(f"     • Error reading payload: {e}")
    else:
        print(f"     • No payload received yet. Send a manual test export from Health Auto Export!")

    print(f"\n{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")


def handle_sleep_command(agy_dir: Path, venv_py: Path, args_list: list[str]):
    """Inspects sleep records or allows manual entry/logging of sleep."""
    gold = TerminalUI.GOLD
    cyan = TerminalUI.CYAN
    bold = TerminalUI.BOLD
    green = TerminalUI.GREEN
    yellow = TerminalUI.YELLOW
    gray = TerminalUI.GRAY
    reset = TerminalUI.RESET

    sleep_csv = agy_dir / "apple_sleep.csv"

    parser = argparse.ArgumentParser(prog="athx sleep", description="Inspect or manually log sleep for ATHX")
    parser.add_argument("hours", nargs="?", type=float, default=None, help="Total sleep hours (e.g. 7.5)")
    parser.add_argument("--date", type=str, default=datetime.now().strftime("%Y-%m-%d"), help="Date of sleep (default: today)")
    parser.add_argument("--deep", type=float, default=None, help="Deep sleep hours")
    parser.add_argument("--rem", type=float, default=None, help="REM sleep hours")
    parser.add_argument("--core", type=float, default=None, help="Core sleep hours")
    parser.add_argument("--awake", type=float, default=0.2, help="Awake hours (default: 0.2)")
    parser.add_argument("--in-bed", type=float, default=None, help="In Bed hours (default: total + awake)")
    args = parser.parse_args(args_list)

    if args.hours is not None:
        total = round(args.hours, 1)
        deep = round(args.deep if args.deep is not None else total * 0.18, 1)
        rem = round(args.rem if args.rem is not None else total * 0.22, 1)
        core = round(args.core if args.core is not None else max(0.0, total - deep - rem), 1)
        awake = round(args.awake, 1)
        in_bed = round(args.in_bed if args.in_bed is not None else total + awake, 1)

        # Read existing CSV
        rows = []
        if sleep_csv.exists():
            with open(sleep_csv, "r", encoding="utf-8") as f:
                rows = list(csv.DictReader(f))

        sleep_map = {r["Date"]: r for r in rows if r.get("Date")}
        sleep_map[args.date] = {
            "Date": args.date,
            "Total_Sleep_hrs": str(total),
            "Deep_Sleep_hrs": str(deep),
            "REM_Sleep_hrs": str(rem),
            "Core_Sleep_hrs": str(core),
            "Awake_hrs": str(awake),
            "In_Bed_hrs": str(in_bed)
        }
        updated = sorted(sleep_map.values(), key=lambda x: x["Date"])

        with open(sleep_csv, "w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=["Date", "Total_Sleep_hrs", "Deep_Sleep_hrs", "REM_Sleep_hrs", "Core_Sleep_hrs", "Awake_hrs", "In_Bed_hrs"])
            writer.writeheader()
            writer.writerows(updated)

        print(f"\n{green}✔ Logged sleep for {args.date}:{reset}")
        print(f"  • Total Sleep : {bold}{total} hrs{reset}")
        print(f"  • Deep Sleep  : {deep} hrs")
        print(f"  • REM Sleep   : {rem} hrs")
        print(f"  • Core Sleep  : {core} hrs")
        print(f"  • In Bed      : {in_bed} hrs")
        print(f"\n{cyan}⚡ Rebuilding athlete headquarters with updated sleep...{reset}")
        athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
        builder_script = athx_dir / "generate_unified_athlete_dashboard.py"
        if not builder_script.exists():
            builder_script = agy_dir / "generate_unified_athlete_dashboard.py"
        subprocess.run([str(venv_py), str(builder_script)], cwd=str(athx_dir), check=False)
        print(f"{green}✔ Done! Dashboard updated.{reset}\n")
        return

    # Otherwise show sleep status and recent records
    print(f"\n{gold}{bold}😴 ATHX 2027 • Sleep Extraction & Status{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}")
    athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
    sleep_csv = athx_dir / "apple_sleep.csv"
    if not sleep_csv.exists():
        sleep_csv = agy_dir / "apple_sleep.csv"
    rows = []
    if sleep_csv.exists():
        with open(sleep_csv, "r", encoding="utf-8") as f:
            rows = list(csv.DictReader(f))
        print(f"  📁 File: {gray}{sleep_csv}{reset} ({len(rows)} nights recorded)")
        print(f"\n  {bold}Recent Recorded Nights:{reset}")
        for r in rows[-5:]:
            print(f"  • {r['Date']}: {bold}{r.get('Total_Sleep_hrs')} hrs{reset} (Deep: {r.get('Deep_Sleep_hrs')}h | REM: {r.get('REM_Sleep_hrs')}h | Core: {r.get('Core_Sleep_hrs')}h)")
    else:
        print(f"  ⚠️ {sleep_csv} does not exist.")

    today_str = datetime.now().strftime("%Y-%m-%d")
    has_today = any(r.get("Date") == today_str for r in rows) if sleep_csv.exists() else False

    if not has_today:
        print(f"\n  {yellow}⚠️ Sleep for today ({today_str}) has not been received via webhook.{reset}")
        print(f"  {bold}Possible causes:{reset}")
        print(f"  1. Health Auto Export on iPhone did not include 'Sleep Analysis' in its automated export payload.")
        print(f"     -> Open Health Auto Export on iPhone > Automations > REST API > Metrics: check 'Sleep Analysis'.")
        print(f"  2. Apple Watch did not finalize the sleep session before the last export.")
        print(f"     -> In Health Auto Export on iPhone, tap 'Export Now'.")
        print(f"\n  {bold}Quick Manual Entry:{reset}")
        print(f"  You can instantly record your sleep from the terminal:")
        print(f"  {cyan}athx sleep 7.5{reset}           (logs 7.5 hrs for today with auto-estimated stages)")
        print(f"  {cyan}athx sleep 7.5 --deep 1.6 --rem 1.8{reset}")
    else:
        print(f"\n  {green}✔ Sleep for today ({today_str}) is recorded!{reset}")

    print(f"\n{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")


def handle_garmin_command(agy_dir: Path, venv_py: Path, sub_args: list[str]):
    """Garmin Connect Personal API inspector & synchronization manager."""
    gold = TerminalUI.GOLD
    cyan = TerminalUI.CYAN
    green = TerminalUI.GREEN
    yellow = TerminalUI.YELLOW
    gray = TerminalUI.GRAY
    bold = TerminalUI.BOLD
    reset = TerminalUI.RESET

    parser = argparse.ArgumentParser(prog="athx garmin", description="Garmin Connect Developer Personal API manager")
    parser.add_argument("-s", "--sync", action="store_true", help="Execute sync against Garmin Personal API")
    args, unknown = parser.parse_known_args(sub_args)

    do_sync = args.sync or (len(sub_args) > 0 and sub_args[0].lower() in ["sync", "-s", "--sync"])

    if do_sync:
        print(f"\n{gold}{bold}⚡ ATHX 2027 • Garmin Connect Developer Personal API Sync{reset}")
        print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")
        athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
        sync_script = athx_dir / "garmin_personal_sync.py"
        if not sync_script.exists():
            sync_script = agy_dir / "garmin_personal_sync.py"
        if not sync_script.exists():
            print(f"  {yellow}⚠️ garmin_personal_sync.py not found in {athx_dir}{reset}\n")
            return
        res = subprocess.run([str(venv_py), str(sync_script)], cwd=str(athx_dir))
        if res.returncode == 0:
            print(f"\n  {green}✔ Garmin Personal API Synchronization completed successfully.{reset}\n")
        else:
            print(f"\n  {yellow}⚠️ Sync exited with code {res.returncode}.{reset}\n")
        return

    # Status / inspection view
    api_key = get_garmin_api_key(agy_dir)
    tok_status = get_garmin_token_status(agy_dir)

    print(f"\n{gold}{bold}⚡ ATHX 2027 • Garmin Connect Developer Program Personal API{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}")
    print(f"  🌐 Endpoint        : {gray}https://personal.connectapi.garmin.com{reset}")
    if api_key:
        masked = api_key[:12] + "..." + api_key[-4:] if len(api_key) > 20 else "Configured"
        print(f"  🔑 Personal ApiKey : {green}✔ Active{reset} {gray}({masked}){reset}")
    else:
        print(f"  🔑 Personal ApiKey : {yellow}⚠️ Not configured{reset} {gray}(set GARMIN_PERSONAL_API_KEY in .env){reset}")

    if tok_status.get("valid"):
        print(f"  🎟 Bearer Token    : {green}✔ Active{reset} {gray}({tok_status['message']}){reset}")
        sub_display = tok_status.get('sub') or "Athlete Developer Key"
        print(f"  👤 Subject ID      : {cyan}{sub_display}{reset}")
        print(f"  🎯 Scope           : {cyan}{tok_status.get('scope', 'personal-api')}{reset}")
    elif tok_status.get("exists"):
        print(f"  🎟 Bearer Token    : {yellow}⚠️ {tok_status['message']}{reset}")
    else:
        print(f"  🎟 Bearer Token    : {gray}○ None cached (runs on first sync){reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")

    # Show dataset status
    print(f"  {bold}📊 Extracted Datasets & Sports-Science Telemetry:{reset}")
    athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
    strength_json = athx_dir / "garmin_extracted_workouts.json"
    running_json = athx_dir / "garmin_running_activities.json"
    workout_json = athx_dir / "garmin_workout_activities.json"
    hrv_json = athx_dir / "garmin_hrv_summary.json"
    sleep_json = athx_dir / "garmin_sleep_summary.json"
    wellness_json = athx_dir / "garmin_daily_summaries.json"

    datasets = [
        ("Strength Sets (VBT)", strength_json, lambda d: f"{len(d):,} sets across movements"),
        ("Running Dynamics", running_json, lambda d: f"{len(d)} runs (GCT, VR, GAP pace)"),
        ("Cardio / CrossFit", workout_json, lambda d: f"{len(d)} sessions logged"),
        ("Overnight HRV (Plews)", hrv_json, lambda d: f"{len(d)} nights baseline"),
        ("Sleep Need & SpO2", sleep_json, lambda d: f"{len([x for x in d if x.get('sleepTimeSeconds')])} nights with dynamic need"),
        ("Daily Allostatic Stress", wellness_json, lambda d: f"{len(d)} days (Net BB & stress)"),
    ]

    for label, path, formatter in datasets:
        if path.exists():
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                info = formatter(data)
                mtime = datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
                print(f"  • {label:24}: {green}✔ {info:36}{reset} {gray}({mtime}){reset}")
            except Exception:
                print(f"  • {label:24}: {yellow}error reading{reset}")
        else:
            print(f"  • {label:24}: {gray}○ Not extracted yet{reset}")

    print(f"\n  {gray}💡 Commands:{reset}")
    print(f"     athx garmin --sync      {gray}# Fetch latest activities, HRV, sleep & daily wellness{reset}")
    print(f"     athx --garmin           {gray}# Display this inspection panel{reset}\n")


def handle_doctor_command(agy_dir: Path, venv_py: Path):
    """Executes full diagnostic suite across all ATHX ecosystem pillars."""
    gold = TerminalUI.GOLD
    cyan = TerminalUI.CYAN
    green = TerminalUI.GREEN
    yellow = TerminalUI.YELLOW
    red = TerminalUI.RED
    gray = TerminalUI.GRAY
    bold = TerminalUI.BOLD
    reset = TerminalUI.RESET

    print(f"\n{gold}{bold}🩺 ATHX 2027 • System Diagnostic Doctor{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")

    checks = []

    # 1. Python Runtime
    py_ver = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    py_ok = sys.version_info >= (3, 9)
    checks.append((
        "Python Runtime",
        "PASS" if py_ok else "FAIL",
        f"v{py_ver} ({venv_py})"
    ))

    # 2. Garmin Personal API Key
    api_key = get_garmin_api_key(agy_dir)
    key_loc = "environment" if "GARMIN_PERSONAL_API_KEY" in os.environ else ".env file"
    checks.append((
        "Garmin Personal API Key",
        "PASS" if api_key else "WARN",
        f"Configured in {key_loc}" if api_key else "Not set (set GARMIN_PERSONAL_API_KEY)"
    ))

    # 3. Garmin Personal JWT Bearer Token
    tok = get_garmin_token_status(agy_dir)
    tok_status = "PASS" if tok.get("valid") else ("WARN" if tok.get("exists") else "FAIL")
    checks.append((
        "Garmin JWT Token",
        tok_status,
        tok.get("message", "No token cached")
    ))

    # 4. Garmin Datasets
    athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
    cal_dir = agy_dir / "legacy_calendar" if (agy_dir / "legacy_calendar").is_dir() else agy_dir

    g_sets = athx_dir / "garmin_extracted_workouts.json"
    g_hrv = athx_dir / "garmin_hrv_summary.json"
    g_sleep = athx_dir / "garmin_sleep_summary.json"
    g_daily = athx_dir / "garmin_daily_summaries.json"
    g_all_exist = all(p.exists() or (agy_dir / p.name).exists() for p in [g_sets, g_hrv, g_sleep, g_daily])
    checks.append((
        "Garmin Data Pipeline",
        "PASS" if g_all_exist else "WARN",
        "Biometrics, HRV, sleep & wellness synced" if g_all_exist else "Some datasets missing (run: athx garmin --sync)"
    ))

    # 5. Apple Health Datasets
    ap_sleep = athx_dir / "apple_sleep.csv"
    ap_body = athx_dir / "apple_body_composition.csv"
    ap_ok = (ap_sleep.exists() or (agy_dir / "apple_sleep.csv").exists()) and (ap_body.exists() or (agy_dir / "apple_body_composition.csv").exists())
    checks.append((
        "Apple Health Datasets",
        "PASS" if ap_ok else "WARN",
        "Sleep & body composition CSVs available" if ap_ok else "Incomplete CSVs (check iPhone webhook)"
    ))

    # 6. Webhook Server (:8080)
    in_use = is_port_in_use(8080)
    checks.append((
        "Webhook Server (:8080)",
        "PASS" if in_use else "INFO",
        "Online and listening" if in_use else "Offline (start with: athx serve -d)"
    ))

    # 7. Tri-Calendar Integration
    cal_html = cal_dir / "calendar_dashboard.html"
    cal_ok = cal_html.exists() or (agy_dir / "calendar_dashboard.html").exists()
    checks.append((
        "Tri-Calendar Feed",
        "PASS" if cal_ok else "WARN",
        "calendar_dashboard.html generated" if cal_ok else "Not generated yet"
    ))

    # 8. Athlete Headquarters Dashboard
    dash_html = athx_dir / "garmin_workout.html"
    index_html = athx_dir / "index.html"
    dash_ok = (dash_html.exists() or (agy_dir / "garmin_workout.html").exists()) and (index_html.exists() or (agy_dir / "index.html").exists())
    if dash_ok:
        active_dash = dash_html if dash_html.exists() else (agy_dir / "garmin_workout.html")
        sz_mb = active_dash.stat().st_size / (1024 * 1024)
        dash_desc = f"Ready ({sz_mb:.2f} MB, garmin_workout.html & index.html)"
    else:
        dash_desc = "Missing dashboard files (run: athx)"
    checks.append((
        "Athlete Dashboard",
        "PASS" if dash_ok else "FAIL",
        dash_desc
    ))

    # 9. Git Cleanliness
    try:
        res = subprocess.run(["git", "-C", str(agy_dir), "status", "-s"], capture_output=True, text=True, timeout=5)
        changed = len([l for l in res.stdout.splitlines() if l.strip()])
        checks.append((
            "Git Repository",
            "PASS" if changed == 0 else "INFO",
            "Working tree clean" if changed == 0 else f"{changed} uncommitted changes"
        ))
    except Exception:
        checks.append(("Git Repository", "WARN", "Could not check git status"))

    # Display results
    total_pass = sum(1 for _, s, _ in checks if s == "PASS")
    total_warn = sum(1 for _, s, _ in checks if s in ["WARN", "INFO"])
    total_fail = sum(1 for _, s, _ in checks if s == "FAIL")

    for name, status, desc in checks:
        if status == "PASS":
            badge = f"{green}✔ PASS{reset}"
        elif status == "INFO":
            badge = f"{cyan}ℹ INFO{reset}"
        elif status == "WARN":
            badge = f"{yellow}⚠️ WARN{reset}"
        else:
            badge = f"{red}✖ FAIL{reset}"
        print(f"  {badge}  {name:26}: {desc}")

    print(f"\n{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}")
    if total_fail == 0 and total_warn == 0:
        print(f"  {green}{bold}🎉 All systems operational! ATHX 2027 ecosystem in peak state.{reset}\n")
    elif total_fail == 0:
        print(f"  {green}{bold}✔ System healthy{reset} {gray}({total_pass} passed, {total_warn} advisories){reset}\n")
    else:
        print(f"  {yellow}{bold}⚠️ System attention required{reset} {gray}({total_fail} failures detected){reset}\n")


# ==============================================================================
# 6. MAIN ORCHESTRATION PIPELINE
# ==============================================================================
def main():
    # Detect subcommand (ignore flags like -h or --coach)
    raw_sub = sys.argv[1].lower() if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else None

    # Coach commands: `athx coach [...]` or `athx ask [...]`
    if raw_sub in ["coach", "ask"] or (len(sys.argv) > 1 and sys.argv[1] in ["coach", "ask"]):
        ensure_correct_python(AGY_DIR)
        import athx_ai_coach
        sub_args = sys.argv[2:]
        if raw_sub == "ask":
            sub_args = ["--ask"] + sub_args
        athx_ai_coach.run_coach_cli(sub_args)
        return

    # Garmin command: `athx garmin [...]`
    if raw_sub == "garmin":
        ensure_correct_python(AGY_DIR)
        venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
        handle_garmin_command(AGY_DIR, venv_py, sys.argv[2:])
        return

    # Doctor command: `athx doctor`
    if raw_sub in ["doctor", "diag"]:
        ensure_correct_python(AGY_DIR)
        venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
        handle_doctor_command(AGY_DIR, venv_py)
        return
        import athx_ai_coach
        sub_args = sys.argv[2:]
        if raw_sub == "ask":
            sub_args = ["--ask"] + sub_args
        athx_ai_coach.run_coach_cli(sub_args)
        return

    # Serve command: `athx serve [...]`
    if raw_sub == "serve":
        ensure_correct_python(AGY_DIR)
        venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
        handle_serve_command(AGY_DIR, venv_py, sys.argv[2:])
        return

    # Stop command alias: `athx stop`
    if raw_sub == "stop":
        success, msg = stop_server_daemon(AGY_DIR, 8080)
        badge = f"{TerminalUI.GREEN}✔{TerminalUI.RESET}" if success else f"{TerminalUI.YELLOW}⚠️{TerminalUI.RESET}"
        print(f"\n  {badge} {msg}\n")
        return

    # Restart command alias: `athx restart`
    if raw_sub == "restart":
        ensure_correct_python(AGY_DIR)
        venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
        handle_serve_command(AGY_DIR, venv_py, ["--restart"])
        return

    # Status command: `athx status`
    if raw_sub == "status":
        ensure_correct_python(AGY_DIR)
        venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
        handle_status_command(AGY_DIR, venv_py)
        return

    # Health command: `athx health [...]`
    if raw_sub == "health":
        ensure_correct_python(AGY_DIR)
        venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
        handle_health_command(AGY_DIR, venv_py, sys.argv[2:])
        return

    # Sleep command: `athx sleep [...]`
    if raw_sub == "sleep":
        ensure_correct_python(AGY_DIR)
        venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
        handle_sleep_command(AGY_DIR, venv_py, sys.argv[2:])
        return

    # Install command: `athx install`
    if raw_sub == "install":
        install_athx_cli()
        return

    # Parse standard pipeline arguments
    cli_args = sys.argv[2:] if raw_sub == "sync" else sys.argv[1:]

    parser = argparse.ArgumentParser(
        description="ATHX 2027 Master Athlete & Intelligence Orchestrator"
    )
    parser.add_argument("--coach", action="store_true", help="Display ATHX AI Coach briefing and recommendations")
    parser.add_argument("--ask", "-q", type=str, help="Ask the ATHX AI Coach a specific training or recovery question")
    parser.add_argument("--no-push", action="store_true", help="Skip automatically pushing updated datasets & dashboards to GitHub after sync")
    parser.add_argument("--push", action="store_true", help="Deprecated alias (auto-push to GitHub is enabled by default)")
    parser.add_argument("--no-open", action="store_true", help="Do not open the dashboard in browser when done")
    parser.add_argument("--skip-git", action="store_true", help="Skip pulling from GitHub")
    parser.add_argument("--skip-drive", action="store_true", help="Deprecated (Google Drive is retired as source of truth)")
    parser.add_argument("--skip-health", action="store_true", help="Skip Apple Health sync")
    parser.add_argument("--skip-garmin", action="store_true", help="Skip Garmin Connect sync")
    parser.add_argument("--skip-cal", action="store_true", help="Skip multi-calendar sync")
    parser.add_argument("--install", action="store_true", help="Install `athx` globally into ~/.local/bin")
    parser.add_argument("--serve", action="store_true", help="Run local orchestrator HTTP daemon on port 8080")
    parser.add_argument("--status", action="store_true", help="Show system and webhook status")
    parser.add_argument("--health", action="store_true", help="Show Apple Health setup and webhook guide")
    parser.add_argument("--sleep", action="store_true", help="Show sleep extraction status or log sleep")
    parser.add_argument("--garmin", action="store_true", help="Inspect Garmin Connect Developer Personal API and telemetry")
    parser.add_argument("--doctor", action="store_true", help="Run system diagnostics across all integrations")
    args = parser.parse_args(cli_args)

    if args.sleep:
        ensure_correct_python(AGY_DIR)
        venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
        handle_sleep_command(AGY_DIR, venv_py, [])
        return

    if args.coach or args.ask:
        ensure_correct_python(AGY_DIR)
        import athx_ai_coach
        if args.ask:
            athx_ai_coach.run_coach_cli(["--ask", args.ask])
        else:
            athx_ai_coach.run_coach_cli([])
        return

    if args.install:
        install_athx_cli()
        return

    ensure_correct_python(AGY_DIR)
    venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)

    if args.garmin:
        handle_garmin_command(AGY_DIR, venv_py, [])
        return

    if args.doctor:
        handle_doctor_command(AGY_DIR, venv_py)
        return

    if args.serve:
        handle_serve_command(AGY_DIR, venv_py, [])
        return

    if args.status:
        handle_status_command(AGY_DIR, venv_py)
        return

    if args.health:
        handle_health_command(AGY_DIR, venv_py, [])
        return

    # Print ATHX Banner
    start_time = time.time()
    gold = TerminalUI.GOLD
    cyan = TerminalUI.CYAN
    bold = TerminalUI.BOLD
    reset = TerminalUI.RESET

    print(f"\n{gold}{bold}⚡ ATHX 2027 • Master Athlete & Intelligence Hub{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}")
    print(f"  📁 Hub Location : {TerminalUI.GRAY}{AGY_DIR}{reset}")
    print(f"  🐍 Environment  : {TerminalUI.GRAY}{venv_py}{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")

    # Define execution pipeline steps
    steps = []
    if not args.skip_git:
        steps.append(("Pulling latest edits from GitHub", lambda: run_git_pull(AGY_DIR)))
    if not args.skip_health:
        steps.append(("Syncing Apple Health biometrics & sleep", lambda: run_health_sync(AGY_DIR, venv_py)))
    if not args.skip_garmin:
        steps.append(("Extracting Garmin strength, running & workouts", lambda: run_garmin_sync(AGY_DIR, venv_py)))
    if not args.skip_cal:
        steps.append(("Syncing legacy calendar cache [DEPRECATED -> Meeting Hub]", lambda: run_calendar_sync(AGY_DIR, venv_py)))
    steps.append(("Rebuilding ATHX 2027 Athlete Headquarters", lambda: run_athlete_dashboard_build(AGY_DIR, venv_py)))
    if not args.no_push:
        steps.append(("Pushing updated datasets & dashboards to GitHub", lambda: run_git_push(AGY_DIR)))

    ui = TerminalUI(total_steps=len(steps))

    for idx, (label, func) in enumerate(steps, 1):
        ui.start_step(idx, label)
        status, msg = func()
        ui.finish_step(status=status, message=msg)

    total_time = time.time() - start_time
    workout_html = (ATHX_DIR / "garmin_workout.html") if (ATHX_DIR / "garmin_workout.html").exists() else (AGY_DIR / "garmin_workout.html")
    cal_html = (LEGACY_CAL_DIR / "calendar_dashboard.html") if (LEGACY_CAL_DIR / "calendar_dashboard.html").exists() else (AGY_DIR / "calendar_dashboard.html")
    meeting_html = AGY_DIR / "meeting_hub.html"

    print(f"\n{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}")
    print(f"  {TerminalUI.GREEN}✨ ATHX Orchestration Complete!{reset} {TerminalUI.GRAY}(Total time: {total_time:.1f}s){reset}")
    print(f"  🏆 Athlete Dashboard  : {TerminalUI.BOLD}{workout_html.as_uri()}{reset}")
    print(f"  💼 Meeting Hub        : {TerminalUI.BOLD}{meeting_html.as_uri()}{reset} {TerminalUI.GRAY}(http://localhost:8080/meeting){reset}")
    print(f"  📅 Calendar (Legacy)  : {TerminalUI.GRAY}{cal_html.as_uri()} [DEPRECATED]{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")

    # Display AI Coach Executive Verdict
    briefing_file = (ATHX_DIR / "athlete_coach_briefing.json") if (ATHX_DIR / "athlete_coach_briefing.json").exists() else (AGY_DIR / "athlete_coach_briefing.json")
    if briefing_file.exists():
        try:
            with open(briefing_file, "r", encoding="utf-8") as f:
                briefing_data = json.load(f)
            import athx_ai_coach
            print(athx_ai_coach.format_executive_verdict_terminal(briefing_data))
            print(f"\n{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")
        except Exception:
            pass

    if not args.no_open:
        print("🚀 Opening ATHX Dashboard in your default browser...\n")
        open_dashboard(workout_html)


if __name__ == "__main__":
    main()

