    print()

    # 2. Apple Health Datasets
    print(f"  {bold}🍏 Apple Health Datasets{reset}")
    datasets = [
        ("Body Composition", athx_dir / "apple_body_composition.csv"),
        ("Daily Activity", athx_dir / "apple_daily_activity.csv"),
        ("Sleep Analysis", athx_dir / "apple_sleep.csv"),
