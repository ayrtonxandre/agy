#!/usr/bin/env python3
"""
================================================================================
⚡ ATHX 2027 • Master Athlete & Intelligence Orchestrator
================================================================================
Single-word CLI command (`athx`) that activates all orchestration:
  1. Pulls last edits from GitHub (git pull --rebase)
  2. Syncs Apple Health biometrics (MCP / Webhook)
  3. Syncs Garmin Connect strength, running & workouts (extract_garmin_strength.py)
  4. Syncs tri-calendar schedule (Google, iCloud, Clariane) & builds calendar dashboard
  5. Rebuilds Unified ATHX 2027 Athlete Headquarters (garmin_workout.html & index.html)
  6. Pushes updated datasets & dashboards to GitHub (origin/main)
  7. Opens the interactive dashboard in your default browser

Cross-machine ready: works identically on Machine 1 and Machine 2.
"""

from __future__ import annotations
import os
import sys
import time
import json
import csv
import shutil
import socket
import signal
import argparse
import threading
import subprocess
import webbrowser
from datetime import datetime
from pathlib import Path

# ==============================================================================
# 1. CROSS-MACHINE PATH & PYTHON RESOLUTION
# ==============================================================================
CONFIG_DIR = Path.home() / ".config" / "agy"
CONFIG_FILE = CONFIG_DIR / "config.json"

def locate_agy_dir() -> Path:
    """Finds the AGY repository directory dynamically across machines."""
    # 1. Check environment variable
    if "AGY_DIR" in os.environ and os.path.isdir(os.environ["AGY_DIR"]):
        return Path(os.environ["AGY_DIR"]).resolve()

    # 2. Check resolve of this script (handles symlinks)
    self_path = Path(__file__).resolve()
    if (self_path.parent.parent / "orchestrator.py").exists():
        return self_path.parent.parent
    if (self_path.parent / "garmin_workout.html").exists() or (self_path.parent / "orchestrator.py").exists():
        return self_path.parent

    # 3. Check persistent config file
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                saved_path = Path(data.get("agy_dir", ""))
                if saved_path.exists():
                    return saved_path.resolve()
        except Exception:
            pass

    # 4. Check standard candidate directories
    candidates = [
        Path.home() / "Documents" / "work" / "AGY",
        Path.home() / "Documents" / "work" / "agy",
        Path.home() / "Documents" / "AGY",
        Path.home() / "Documents" / "agy",
        Path.home() / "work" / "AGY",
        Path.home() / "work" / "agy",
        Path.home() / "agy",
        Path.home() / "AGY",
        Path.cwd(),
    ]
    for c in candidates:
        if (c / "orchestrator.py").exists() and ((c / "athx").is_dir() or (c / "athx_analytics.py").exists()):
            return c.resolve()

    # Fallback to current directory
    return Path.cwd().resolve()


AGY_DIR = locate_agy_dir()
ATHX_DIR = AGY_DIR / "athx" if (AGY_DIR / "athx").is_dir() else AGY_DIR
LEGACY_CAL_DIR = AGY_DIR / "legacy_calendar" if (AGY_DIR / "legacy_calendar").is_dir() else AGY_DIR

if str(ATHX_DIR) not in sys.path:
    sys.path.insert(0, str(ATHX_DIR))

def find_virtualenv_python(agy_dir: Path) -> Path | None:
    """Locates the virtualenv Python binary across machines."""
    # 1. Check persistent config
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                p = Path(data.get("python_bin", ""))
                if p.exists() and os.access(str(p), os.X_OK):
                    return p
        except Exception:
            pass

    # 2. Check virtualenv prefix
    if hasattr(sys, "base_prefix") and sys.prefix != sys.base_prefix:
        p_bin = Path(sys.prefix) / "bin" / "python"
        if p_bin.exists():
            return p_bin
        p_exe = Path(sys.prefix) / "Scripts" / "python.exe"
        if p_exe.exists():
            return p_exe

    # 3. Check candidate paths relative to repo
    candidates = [
        # In repo
        agy_dir / ".venv" / "bin" / "python",
        agy_dir / ".venv" / "Scripts" / "python.exe",
        # In parent directory
        agy_dir.parent / ".venv" / "bin" / "python",
        agy_dir.parent / ".venv" / "Scripts" / "python.exe",
        # In home / work
        Path.home() / "Documents" / "work" / ".venv" / "bin" / "python",
        Path.home() / ".venv" / "bin" / "python",
    ]
    if "VIRTUAL_ENV" in os.environ:
        ve = Path(os.environ["VIRTUAL_ENV"])
        candidates.insert(0, ve / "bin" / "python")
        candidates.insert(1, ve / "Scripts" / "python.exe")

    for c in candidates:
        if c.exists() and os.access(str(c), os.X_OK):
            return c
    return None


def ensure_correct_python(agy_dir: Path):
    """Ensures this script is running inside the virtualenv with dependencies."""
    can_import = True
    required = ["pandas", "requests"]
    has_personal_key = bool(os.environ.get("GARMIN_PERSONAL_API_KEY") or (agy_dir / ".env").exists())
    if not has_personal_key:
        required.append("garminconnect")

    for mod in required:
        try:
            __import__(mod)
        except ImportError:
            can_import = False
            break

    if can_import:
        return

    venv_py = find_virtualenv_python(agy_dir)
    if venv_py and str(venv_py) != sys.executable:
        os.execv(str(venv_py), [str(venv_py)] + sys.argv)


# ==============================================================================
# 2. ANIMATED TERMINAL LOADING BAR & SPINNER ENGINE
# ==============================================================================
class TerminalUI:
    # ANSI color codes
    CYAN = "\033[96m"
    GOLD = "\033[38;5;220m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    RED = "\033[91m"
    GRAY = "\033[90m"
    BOLD = "\033[1m"
    RESET = "\033[0m"

    SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    BAR_WIDTH = 24

    def __init__(self, total_steps: int):
        self.total_steps = total_steps
        self.current_step = 0
        self.step_name = ""
        self.step_start_time = time.time()
        self.spinner_idx = 0
        self.running = False
        self.thread: threading.Thread | None = None
        self.is_tty = sys.stdout.isatty()

    def start_step(self, step_num: int, name: str):
        self.current_step = step_num
        self.step_name = name
        self.step_start_time = time.time()
        self.running = True

        if self.is_tty:
            self.thread = threading.Thread(target=self._animate, daemon=True)
            self.thread.start()
        else:
            print(f"[{self.current_step}/{self.total_steps}] {self.step_name}...")

    def _render_bar(self, progress_ratio: float) -> str:
        filled_len = int(self.BAR_WIDTH * progress_ratio)
        filled = "█" * filled_len
        unfilled = "░" * (self.BAR_WIDTH - filled_len)
        pct = int(progress_ratio * 100)
        return f"{self.CYAN}[{filled}{unfilled}]{self.RESET} {pct:>3}%"

    def _animate(self):
        while self.running:
            frame = self.SPINNER_FRAMES[self.spinner_idx % len(self.SPINNER_FRAMES)]
            self.spinner_idx += 1
            progress = (self.current_step - 1) / self.total_steps
            bar_str = self._render_bar(progress)
            
            line = (
                f"\r  {bar_str} "
                f"{self.GOLD}{frame}{self.RESET} "
                f"{self.BOLD}[{self.current_step}/{self.total_steps}]{self.RESET} "
                f"{self.step_name}\033[K"
            )
            sys.stdout.write(line)
            sys.stdout.flush()
            time.sleep(0.08)

    def finish_step(self, status: str = "success", message: str = ""):
        self.running = False
        if self.thread and self.thread.is_alive():
            self.thread.join(timeout=0.3)

        elapsed = time.time() - self.step_start_time
        time_str = f"{self.GRAY}({elapsed:.1f}s){self.RESET}"
        progress = self.current_step / self.total_steps
        bar_str = self._render_bar(progress)

        if status == "success":
            badge = f"{self.GREEN}✔{self.RESET}"
        elif status == "warning":
            badge = f"{self.YELLOW}⚠️{self.RESET}"
        else:
            badge = f"{self.RED}✖{self.RESET}"

        text = message or self.step_name
        if self.is_tty:
            line = (
                f"\r  {bar_str} "
                f"{badge} "
                f"{self.BOLD}[{self.current_step}/{self.total_steps}]{self.RESET} "
                f"{text} {time_str}\033[K\n"
            )
        else:
            line = f"  {badge} [{self.current_step}/{self.total_steps}] {text} ({elapsed:.1f}s)\n"

        sys.stdout.write(line)
        sys.stdout.flush()


# ==============================================================================
# 3. DAEMON & NETWORK ENGINE (REST Webhook Server)
# ==============================================================================
def is_port_in_use(port: int = 8080) -> bool:
    """Checks if a TCP port is in use on localhost."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(("", port))
            return False
        except OSError:
            return True


def is_pid_alive(pid: int) -> bool:
    """Checks if a process with given PID exists."""
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True
    except (ProcessLookupError, OSError):
        return False


def find_port_pids(port: int = 8080) -> list[int]:
    """Finds all PIDs listening on the specified port via lsof."""
    try:
        res = subprocess.run(
            ["lsof", "-t", f"-i:{port}"],
            capture_output=True,
            text=True,
            timeout=4
        )
        if res.returncode == 0:
            return [int(p.strip()) for p in res.stdout.splitlines() if p.strip().isdigit()]
    except Exception:
        pass
    return []


def get_server_pid(agy_dir: Path, port: int = 8080) -> int | None:
    """Reads PID from server.pid or falls back to port inspection."""
    pid_file = agy_dir / "server.pid"
    if pid_file.exists():
        try:
            pid = int(pid_file.read_text().strip())
            if is_pid_alive(pid):
                return pid
            else:
                pid_file.unlink(missing_ok=True)
        except Exception:
            pass

    pids = find_port_pids(port)
    if pids:
        try:
            pid_file.write_text(str(pids[0]))
        except Exception:
            pass
        return pids[0]
    return None


def get_network_endpoints(port: int = 8080) -> dict[str, str]:
    """Resolves local mDNS and LAN IP endpoints for Apple Health webhook."""
    try:
        from orchestrator import get_network_endpoints as _orch_endpoints
        return _orch_endpoints(port)
    except Exception:
        pass

    mdns_host = "Ayrtons-MacBook-Air.local"
    try:
        cmd = subprocess.run(["scutil", "--get", "LocalHostName"], capture_output=True, text=True, timeout=2)
        if cmd.returncode == 0 and cmd.stdout.strip():
            mdns_host = f"{cmd.stdout.strip()}.local"
    except Exception:
        pass

    lan_ip = "127.0.0.1"
    try:
        cmd = subprocess.run(["ipconfig", "getifaddr", "en0"], capture_output=True, text=True, timeout=2)
        if cmd.returncode == 0 and cmd.stdout.strip():
            lan_ip = cmd.stdout.strip()
    except Exception:
        pass

    return {
        "webhook_mdns": f"http://{mdns_host}:{port}/api/health",
        "webhook_lan": f"http://{lan_ip}:{port}/api/health",
        "dashboard_local": f"http://localhost:{port}/",
        "healthcheck": f"http://{lan_ip}:{port}/health"
    }


def stop_server_daemon(agy_dir: Path, port: int = 8080) -> tuple[bool, str]:
    """Stops the running orchestrator daemon cleanly."""
    pids = []
    pid_file = agy_dir / "server.pid"
    if pid_file.exists():
        try:
            p = int(pid_file.read_text().strip())
            if p > 0:
                pids.append(p)
        except Exception:
            pass

    for p in find_port_pids(port):
        if p not in pids:
            pids.append(p)

    if not pids and not is_port_in_use(port):
        return False, f"ATHX Orchestrator is not running (port {port} is free)."

    stopped = False
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
            stopped = True
        except Exception:
            pass

    time.sleep(0.6)
    for pid in pids:
        if is_pid_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass

    pid_file.unlink(missing_ok=True)
    if not is_port_in_use(port):
        pid_list = ", ".join(map(str, pids)) or f"port {port}"
        return True, f"ATHX Orchestrator stopped successfully (terminated PID: {pid_list})."
    return True, f"Sent stop signal to ATHX Orchestrator (PID: {', '.join(map(str, pids))})."


def start_server_daemon(agy_dir: Path, venv_py: Path, port: int = 8080):
    """Spawns the orchestrator HTTP daemon in the background."""
    orch_py = agy_dir / "orchestrator.py"
    log_file_path = agy_dir / "server_access.log"
    pid_file = agy_dir / "server.pid"

    if is_port_in_use(port):
        existing_pid = get_server_pid(agy_dir, port)
        pid_str = f" (PID: {existing_pid})" if existing_pid else ""
        print(f"\n{TerminalUI.GOLD}⚡ ATHX Orchestrator is already active on port {port}{pid_str}.{TerminalUI.RESET}")
        net = get_network_endpoints(port)
        print(f"  • Webhook (iPhone) : {TerminalUI.CYAN}{net['webhook_mdns']}{TerminalUI.RESET}")
        print(f"  • Webhook (LAN IP) : {TerminalUI.CYAN}{net['webhook_lan']}{TerminalUI.RESET}")
        print(f"  • Local Dashboard  : {TerminalUI.CYAN}{net['dashboard_local']}{TerminalUI.RESET}")
        print(f"  {TerminalUI.GRAY}To stop:    athx stop (or athx serve --stop){TerminalUI.RESET}\n")
        return

    net = get_network_endpoints(port)
    env = dict(os.environ, PORT=str(port), AGY_PORT=str(port))

    with open(log_file_path, "a", encoding="utf-8") as log_f:
        proc = subprocess.Popen(
            [str(venv_py), str(orch_py), "serve"],
            cwd=str(agy_dir),
            env=env,
            stdout=log_f,
            stderr=subprocess.STDOUT,
            start_new_session=True
        )

    pid_file.write_text(str(proc.pid))
    time.sleep(0.6)

    if is_port_in_use(port) or is_pid_alive(proc.pid):
        print(f"\n{TerminalUI.GREEN}✔ ATHX Orchestrator daemon started in background (PID: {proc.pid}){TerminalUI.RESET}")
        print(f"  • Webhook (iPhone) : {TerminalUI.CYAN}{net['webhook_mdns']}{TerminalUI.RESET}")
        print(f"  • Webhook (LAN IP) : {TerminalUI.CYAN}{net['webhook_lan']}{TerminalUI.RESET}")
        print(f"  • Local Dashboard  : {TerminalUI.CYAN}{net['dashboard_local']}{TerminalUI.RESET}")
        print(f"  • Access Log       : {TerminalUI.GRAY}{log_file_path}{TerminalUI.RESET}")
        print(f"  {TerminalUI.GRAY}To monitor logs: tail -f {log_file_path}{TerminalUI.RESET}")
        print(f"  {TerminalUI.GRAY}To stop daemon:  athx stop (or athx serve --stop){TerminalUI.RESET}\n")
    else:
        print(f"\n{TerminalUI.RED}✖ Failed to start orchestrator daemon. Check logs at: {log_file_path}{TerminalUI.RESET}\n")


# ==============================================================================
# 4. INDIVIDUAL ORCHESTRATION TASKS
# ==============================================================================
def run_git_pull(agy_dir: Path) -> tuple[str, str]:
    """Pulls latest changes from GitHub."""
    git_bin = shutil.which("git")
    if not git_bin:
        return "warning", "Git not found in PATH (skipped)"

    dot_git = agy_dir / ".git"
    if not dot_git.exists():
        return "warning", "Not a git repository (skipped)"

    try:
        res = subprocess.run(
            [git_bin, "-C", str(agy_dir), "pull", "--rebase", "--autostash"],
            capture_output=True,
            text=True,
            timeout=15
        )
        if res.returncode == 0:
            out = res.stdout.strip()
            if "Already up to date" in out:
                return "success", "GitHub: Branch is up to date with origin/main"
            return "success", "GitHub: Pulled latest changes successfully"
        else:
            res2 = subprocess.run(
                [git_bin, "-C", str(agy_dir), "pull"],
                capture_output=True,
                text=True,
                timeout=15
            )
            if res2.returncode == 0:
                return "success", "GitHub: Pulled latest changes successfully"
            err = res.stderr.strip().splitlines()
            err_line = err[-1] if err else "Git pull skipped"
            return "warning", f"GitHub pull: {err_line[:50]}"
    except subprocess.TimeoutExpired:
        return "warning", "GitHub: Connection timed out (skipped)"
    except Exception as e:
        return "warning", f"GitHub: {e}"


def run_git_push(agy_dir: Path) -> tuple[str, str]:
    """Automatically stages updated data files and dashboards, commits, and pushes to GitHub."""
    git_bin = shutil.which("git")
    if not git_bin:
        return "warning", "Git not found in PATH (push skipped)"

    try:
        # 1. Check if there are changes
        status_res = subprocess.run(
            [git_bin, "-C", str(agy_dir), "status", "--porcelain"],
            capture_output=True,
            text=True,
            timeout=10
        )
        if status_res.returncode != 0:
            return "warning", "Git status check failed"

        changes = status_res.stdout.strip()
        if not changes:
            return "success", "GitHub: Working tree clean (up to date with remote)"

        # 2. Stage updated files
        subprocess.run(
            [git_bin, "-C", str(agy_dir), "add", "-A"],
            capture_output=True,
            text=True,
            timeout=15
        )

        # 3. Create structured commit
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M")
        commit_msg = f"chore(data): automated sync biometrics, workouts & dashboards [{timestamp}]"
        commit_res = subprocess.run(
            [git_bin, "-C", str(agy_dir), "commit", "-m", commit_msg],
            capture_output=True,
            text=True,
            timeout=15
        )
        if commit_res.returncode != 0:
            return "success", "GitHub: No new changes to commit"

        # 4. Push to remote origin main
        push_res = subprocess.run(
            [git_bin, "-C", str(agy_dir), "push", "origin", "main"],
            capture_output=True,
            text=True,
            timeout=30
        )
        if push_res.returncode == 0:
            return "success", "GitHub: Synced & pushed latest datasets & dashboards to origin/main"
        else:
            err = push_res.stderr.strip().splitlines()
            err_line = err[-1] if err else "Git push failed"
            return "warning", f"GitHub push: {err_line[:60]}"
    except subprocess.TimeoutExpired:
        return "warning", "GitHub: Push connection timed out (skipped)"
    except Exception as e:
        return "warning", f"GitHub push error: {e}"


def run_health_sync(agy_dir: Path, venv_py: Path) -> tuple[str, str]:
    """Syncs Apple Health biometrics via Automated Webhook and verifies local datasets."""
    athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
    last_payload = athx_dir / "last_payload.json"
    body_csv = athx_dir / "apple_body_composition.csv"
    activity_csv = athx_dir / "apple_daily_activity.csv"
    sleep_csv = athx_dir / "apple_sleep.csv"
    orch_py = agy_dir / "orchestrator.py"

    # If payload is newer than CSVs (e.g. manual copy or recovery), ingest it
    if last_payload.exists() and orch_py.exists():
        payload_mtime = last_payload.stat().st_mtime
        csv_mtime = body_csv.stat().st_mtime if body_csv.exists() else 0
        if not body_csv.exists() or payload_mtime > (csv_mtime + 2):
            try:
                subprocess.run(
                    [str(venv_py), str(orch_py), "ingest", str(last_payload)],
                    cwd=str(agy_dir),
                    capture_output=True,
                    timeout=20
                )
            except Exception:
                pass

    # Check local CSVs for newest date
    latest_date = None
    row_count = 0
    for cand in [activity_csv, body_csv, sleep_csv]:
        if cand.exists():
            try:
                with open(cand, "r", encoding="utf-8", errors="ignore") as f:
                    lines = [l.strip() for l in f if l.strip()]
                    if len(lines) > 1:
                        row_count += len(lines) - 1
                        d = lines[-1].split(",")[0].strip()
                        if d and (not latest_date or d > latest_date):
                            latest_date = d
            except Exception:
                pass

    server_up = is_port_in_use(8080)
    if latest_date:
        if server_up:
            return "success", f"Apple Health: Automated Webhook active (:8080) | Biometrics up to date ({latest_date})"
        else:
            return "success", f"Apple Health: Biometrics up to date ({latest_date}) | Webhook daemon offline (run 'athx serve')"

    if server_up:
        return "warning", "Apple Health: Webhook active on :8080, awaiting first iPhone sync (run 'athx health')"
    return "warning", "Apple Health: No biometrics found (configure iPhone webhook: run 'athx health')"


def get_garmin_api_key(agy_dir: Path) -> str | None:
    """Retrieves Garmin Personal API Key from environment or .env file."""
    api_key = os.environ.get("GARMIN_PERSONAL_API_KEY")
    if api_key:
        return api_key.strip()
    env_file = agy_dir / ".env"
    if env_file.exists():
        try:
            with open(env_file, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("GARMIN_PERSONAL_API_KEY="):
                        val = line.split("=", 1)[1].strip().strip("'\"")
                        if val:
                            return val
        except Exception:
            pass
    return None


def get_garmin_token_status(agy_dir: Path) -> dict:
    """Inspects cached personal API JWT Bearer token and TTL."""
    athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
    tok_file = athx_dir / "garmin_tokens" / "personal_token.json"
    if not tok_file.exists():
        tok_file = agy_dir / "garmin_tokens" / "personal_token.json"
    if not tok_file.exists():
        return {"exists": False, "valid": False, "message": "No token cached"}
    try:
        with open(tok_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        exp = data.get("expires_at", 0)
        remaining = exp - time.time()
        if remaining > 0:
            hrs = remaining / 3600.0
            return {
                "exists": True,
                "valid": True,
                "expires_at": exp,
                "remaining_hours": round(hrs, 1),
                "scope": data.get("scope", "personal-api"),
                "sub": data.get("sub", "athlete"),
                "message": f"Valid ({hrs:.1f}h remaining)"
            }
        else:
            return {
                "exists": True,
                "valid": False,
                "expires_at": exp,
                "remaining_hours": 0.0,
                "scope": data.get("scope", "personal-api"),
                "sub": data.get("sub", "athlete"),
                "message": "Expired (auto-renews on sync)"
            }
    except Exception as e:
        return {"exists": True, "valid": False, "message": f"Parse error: {e}"}


def run_garmin_sync(agy_dir: Path, venv_py: Path) -> tuple[str, str]:
    """Extracts Garmin Connect strength sets, running dynamics, HRV, sleep & daily wellness."""
    athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
    garmin_script = athx_dir / "extract_garmin_strength.py"
    if not garmin_script.exists():
        garmin_script = agy_dir / "extract_garmin_strength.py"
    tokens_dir = athx_dir / "garmin_tokens"
    if not tokens_dir.exists():
        tokens_dir = agy_dir / "garmin_tokens"
    api_key = get_garmin_api_key(agy_dir)

    if not garmin_script.exists():
        return "warning", "extract_garmin_strength.py not found"

    if not tokens_dir.exists() and not api_key:
        return "warning", "Garmin: No API key or cached tokens (skipped)"

    try:
        res = subprocess.run(
            [str(venv_py), str(garmin_script)],
            cwd=str(athx_dir),
            capture_output=True,
            text=True,
            timeout=60
        )
        if res.returncode == 0:
            msg = "Garmin Personal API: Synchronized Strength, Biomechanics, HRV & Sleep"
            return "success", msg
        else:
            return "warning", "Garmin Connect: Sync skipped (using cached session data)"
    except subprocess.TimeoutExpired:
        return "warning", "Garmin Connect: Network timeout (using cached session data)"
    except Exception as e:
        return "warning", f"Garmin Connect: {e}"


def run_calendar_sync(agy_dir: Path, venv_py: Path) -> tuple[str, str]:
    """Generates standalone multi-calendar dashboard across Work, iCloud, and Client."""
    legacy_cal_dir = agy_dir / "legacy_calendar" if (agy_dir / "legacy_calendar").is_dir() else agy_dir
    cal_script = legacy_cal_dir / "generate_calendar_dashboard.py"
    if not cal_script.exists():
        cal_script = agy_dir / "generate_calendar_dashboard.py"
    if not cal_script.exists():
        return "warning", "generate_calendar_dashboard.py not found"

    try:
        res = subprocess.run(
            [str(venv_py), str(cal_script)],
            cwd=str(legacy_cal_dir),
            capture_output=True,
            text=True,
            timeout=30
        )
        if res.returncode == 0:
            return "success", "Legacy Calendar [DEPRECATED]: Cached schedule synced (use Meeting Hub /meeting)"
        else:
            return "warning", "Legacy Calendar [DEPRECATED]: Synchronized using local ICS cache"
    except subprocess.TimeoutExpired:
        return "warning", "Multi-Calendar: Request timeout (using cached schedule)"
    except Exception as e:
        return "warning", f"Multi-Calendar: {e}"


def run_athlete_dashboard_build(agy_dir: Path, venv_py: Path) -> tuple[str, str]:
    """Rebuilds the ATHX 2027 Unified Athlete Headquarters (garmin_workout.html)."""
    athx_dir = agy_dir / "athx" if (agy_dir / "athx").is_dir() else agy_dir
    builder_script = athx_dir / "generate_unified_athlete_dashboard.py"
    if not builder_script.exists():
        builder_script = agy_dir / "generate_unified_athlete_dashboard.py"
    if not builder_script.exists():
        return "error", "generate_unified_athlete_dashboard.py not found"

    try:
        res = subprocess.run(
            [str(venv_py), str(builder_script)],
            cwd=str(athx_dir),
            capture_output=True,
            text=True,
            timeout=25
        )
        if res.returncode == 0:
            return "success", "ATHX 2027: Rebuilt athlete headquarters (garmin_workout.html)"
        else:
            err = res.stderr.strip().splitlines()
            return "error", f"Dashboard build failed: {err[-1] if err else 'Unknown error'}"
    except Exception as e:
        return "error", f"Dashboard build error: {e}"



def open_dashboard(html_path: Path):
    """Opens the generated ATHX dashboard in the system default browser."""
    if not html_path.exists():
        print(f"⚠️ Dashboard file not found at: {html_path}")
        return

    # Prefer localhost:8080 if background server is active
    target_url = html_path.resolve().as_uri()
    try:
        import socket
        with socket.create_connection(("127.0.0.1", 8080), timeout=0.2):
            target_url = "http://localhost:8080/workout"
    except Exception:
        pass

    try:
        if sys.platform == "darwin":
            subprocess.run(["open", target_url], check=False)
            return
    except Exception:
        pass

    try:
        # Use python webbrowser
        webbrowser.open(target_url)
    except Exception:
        # Fallback to OS commands
        if sys.platform == "darwin":
            subprocess.run(["open", str(html_path)], check=False)
        elif sys.platform.startswith("linux"):
            subprocess.run(["xdg-open", str(html_path)], check=False)
        elif sys.platform == "win32":
            os.startfile(str(html_path))


# ==============================================================================
# 4. INSTALLER HELPER
# ==============================================================================
def install_athx_cli():
    """Installs the `athx` command into ~/.local/bin and configures shell PATH."""
    home = Path.home()
    local_bin = home / ".local" / "bin"
    local_bin.mkdir(parents=True, exist_ok=True)
    target_athx = local_bin / "athx"

    script_path = Path(__file__).resolve()

    # Save repository directory to persistent config
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump({"agy_dir": str(AGY_DIR), "installed_at": time.time()}, f, indent=2)

    # Create launcher script in ~/.local/bin/athx
    venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
    launcher_content = f"""#!/bin/sh
exec "{venv_py}" "{script_path}" "$@"
"""
    with open(target_athx, "w", encoding="utf-8") as f:
        f.write(launcher_content)
    target_athx.chmod(0o755)

    # Ensure ~/.local/bin is in PATH in ~/.zshrc or ~/.bashrc
    shell_rcs = [home / ".zshrc", home / ".bashrc"]
    path_line = 'export PATH="$HOME/.local/bin:$PATH"'
    for rc in shell_rcs:
        if rc.exists():
            content = rc.read_text(encoding="utf-8", errors="ignore")
            if ".local/bin" not in content:
                with open(rc, "a", encoding="utf-8") as f:
                    f.write(f"\n# Added by ATHX Orchestrator\n{path_line}\n")
                print(f"  • Added ~/.local/bin to PATH in {rc.name}")

    print("\n✅ Successfully installed `athx` CLI command!")
    print(f"  • Launcher path  : {target_athx}")
    print(f"  • AGY directory  : {AGY_DIR}")
    print(f"  • Python runtime : {venv_py}")
    print("\n⚡ You can now run `athx` from anywhere in your terminal!")


# ==============================================================================
# 5. CLI SUBCOMMAND HANDLERS (serve, status, health)
# ==============================================================================
def handle_serve_command(agy_dir: Path, venv_py: Path, sub_args: list[str]):
    """Handles `athx serve` to manage background daemon or foreground server."""
    parser = argparse.ArgumentParser(prog="athx serve", description="Manage the ATHX Orchestrator REST Webhook daemon")
    parser.add_argument("-d", "--daemon", action="store_true", help="Run orchestrator as a detached background daemon")
    parser.add_argument("-f", "--foreground", action="store_true", help="Run orchestrator attached in the foreground")
    parser.add_argument("--stop", action="store_true", help="Stop the running orchestrator daemon")
    parser.add_argument("--restart", action="store_true", help="Restart the orchestrator daemon")
    parser.add_argument("--status", action="store_true", help="Check orchestrator server status")
    parser.add_argument("-p", "--port", type=int, default=8080, help="Port to listen on (default: 8080)")
    args = parser.parse_args(sub_args)

    port = args.port
    pid = get_server_pid(agy_dir, port)
    in_use = is_port_in_use(port)
    net = get_network_endpoints(port)

    # 1. Stop
    if args.stop:
        success, msg = stop_server_daemon(agy_dir, port)
        badge = f"{TerminalUI.GREEN}✔{TerminalUI.RESET}" if success else f"{TerminalUI.YELLOW}⚠️{TerminalUI.RESET}"
        print(f"\n  {badge} {msg}\n")
        return

    # 2. Status
    if args.status:
        print(f"\n{TerminalUI.GOLD}⚡ ATHX Orchestrator Server Status{TerminalUI.RESET}")
        if in_use:
            pid_str = f" (PID: {pid})" if pid else ""
            print(f"  • Status           : {TerminalUI.GREEN}● ONLINE{TerminalUI.RESET}{pid_str}")
        else:
            print(f"  • Status           : {TerminalUI.YELLOW}○ OFFLINE{TerminalUI.RESET}")
        print(f"  • Webhook (iPhone) : {TerminalUI.CYAN}{net['webhook_mdns']}{TerminalUI.RESET}")
        print(f"  • Webhook (LAN IP) : {TerminalUI.CYAN}{net['webhook_lan']}{TerminalUI.RESET}")
        print(f"  • Local Dashboard  : {TerminalUI.CYAN}{net['dashboard_local']}{TerminalUI.RESET}")
        print(f"  • Healthcheck      : {TerminalUI.GRAY}{net['healthcheck']}{TerminalUI.RESET}\n")
        return

    # 3. Restart
    if args.restart:
        print(f"\n🔄 Restarting ATHX Orchestrator on port {port}...")
        stop_server_daemon(agy_dir, port)
        time.sleep(1)
        start_server_daemon(agy_dir, venv_py, port)
        return

    # 4. If already running
    if in_use:
        pid_str = f" (PID: {pid})" if pid else ""
        print(f"\n{TerminalUI.GOLD}⚡ ATHX Orchestrator is ALREADY running on port {port}{pid_str}{TerminalUI.RESET}")
        print(f"  • Webhook (iPhone) : {TerminalUI.CYAN}{net['webhook_mdns']}{TerminalUI.RESET}")
        print(f"  • Webhook (LAN IP) : {TerminalUI.CYAN}{net['webhook_lan']}{TerminalUI.RESET}")
        print(f"  • Local Dashboard  : {TerminalUI.CYAN}{net['dashboard_local']}{TerminalUI.RESET}")
        print(f"  {TerminalUI.GRAY}To stop:    athx stop (or athx serve --stop){TerminalUI.RESET}")
        print(f"  {TerminalUI.GRAY}To restart: athx restart (or athx serve --restart){TerminalUI.RESET}\n")
        return

    # 5. Start daemon (-d) or foreground
    if args.daemon:
        start_server_daemon(agy_dir, venv_py, port)
    else:
        orch_py = agy_dir / "orchestrator.py"
        print(f"\n{TerminalUI.GOLD}🚀 Starting ATHX Orchestrator on port {port}...{TerminalUI.RESET}")
        print(f"  • Webhook (iPhone) : {TerminalUI.CYAN}{net['webhook_mdns']}{TerminalUI.RESET}")
        print(f"  • Webhook (LAN IP) : {TerminalUI.CYAN}{net['webhook_lan']}{TerminalUI.RESET}")
        print(f"  • Local Dashboard  : {TerminalUI.CYAN}{net['dashboard_local']}{TerminalUI.RESET}")
        print(f"  {TerminalUI.GRAY}Press Ctrl+C to stop the server (or use -d for background daemon).{TerminalUI.RESET}\n")
        try:
            env = dict(os.environ, PORT=str(port), AGY_PORT=str(port))
            subprocess.run([str(venv_py), str(orch_py), "serve"], cwd=str(agy_dir), env=env)
        except KeyboardInterrupt:
            print("\n👋 ATHX Orchestrator stopped.")


def handle_status_command(agy_dir: Path, venv_py: Path):
    """Displays comprehensive ATHX ecosystem status."""
    gold = TerminalUI.GOLD
    cyan = TerminalUI.CYAN
    green = TerminalUI.GREEN
    yellow = TerminalUI.YELLOW
    gray = TerminalUI.GRAY
    bold = TerminalUI.BOLD
    reset = TerminalUI.RESET

    port = 8080
    net = get_network_endpoints(port)
    in_use = is_port_in_use(port)
    pid = get_server_pid(agy_dir, port)

