def install_athx_cli():
    """Installs the `athx` command into ~/.local/bin and configures shell PATH."""
    home = Path.home()
    local_bin = home / ".local" / "bin"
    local_bin.mkdir(parents=True, exist_ok=True)
    target_athx = local_bin / "athx"

    script_path = Path(__file__).resolve()

    # Save repository directory to persistent config
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump({"agy_dir": str(AGY_DIR), "installed_at": time.time()}, f, indent=2)

    # Create launcher script in ~/.local/bin/athx
    venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)
    launcher_content = f"""#!/bin/sh
exec "{venv_py}" "{script_path}" "$@"
"""
    with open(target_athx, "w", encoding="utf-8") as f:
        f.write(launcher_content)
    target_athx.chmod(0o755)

    # Ensure ~/.local/bin is in PATH in ~/.zshrc or ~/.bashrc
    shell_rcs = [home / ".zshrc", home / ".bashrc"]
    path_line = 'export PATH="$HOME/.local/bin:$PATH"'
    for rc in shell_rcs:
        if rc.exists():
            content = rc.read_text(encoding="utf-8", errors="ignore")
            if ".local/bin" not in content:
                with open(rc, "a", encoding="utf-8") as f:
                    f.write(f"\n# Added by ATHX Orchestrator\n{path_line}\n")
                print(f"  • Added ~/.local/bin to PATH in {rc.name}")

    print("\n✅ Successfully installed `athx` CLI command!")
    print(f"  • Launcher path  : {target_athx}")
    print(f"  • AGY directory  : {AGY_DIR}")
    print(f"  • Python runtime : {venv_py}")
    print("\n⚡ You can now run `athx` from anywhere in your terminal!")


# ==============================================================================
# 5. MAIN ORCHESTRATION PIPELINE
# ==============================================================================
def main():
    parser = argparse.ArgumentParser(
        description="ATHX 2027 Master Athlete & Intelligence Orchestrator"
    )
    parser.add_argument("--no-push", action="store_true", help="Skip automatically pushing updated datasets & dashboards to GitHub after sync")
    parser.add_argument("--push", action="store_true", help="Deprecated alias (auto-push to GitHub is enabled by default)")
    parser.add_argument("--no-open", action="store_true", help="Do not open the dashboard in browser when done")
    parser.add_argument("--skip-git", action="store_true", help="Skip pulling from GitHub")
    parser.add_argument("--skip-drive", action="store_true", help="Deprecated (Google Drive is retired as source of truth)")
    parser.add_argument("--skip-health", action="store_true", help="Skip Apple Health sync")
    parser.add_argument("--skip-garmin", action="store_true", help="Skip Garmin Connect sync")
    parser.add_argument("--skip-cal", action="store_true", help="Skip multi-calendar sync")
    parser.add_argument("--install", action="store_true", help="Install `athx` globally into ~/.local/bin")
    parser.add_argument("--serve", action="store_true", help="Run local orchestrator HTTP daemon on port 8080")
    args = parser.parse_args()

    if args.install:
        install_athx_cli()
        return

    # Ensure correct virtual environment
    ensure_correct_python(AGY_DIR)

    # Locate Python binary to invoke sub-scripts
    venv_py = find_virtualenv_python(AGY_DIR) or Path(sys.executable)

    if args.serve:
        orch_py = AGY_DIR / "orchestrator.py"
        print(f"🚀 Starting ATHX Orchestrator server from {AGY_DIR}...")
        subprocess.run([str(venv_py), str(orch_py), "serve"])
        return

    # Print ATHX Banner
    start_time = time.time()
    gold = TerminalUI.GOLD
    cyan = TerminalUI.CYAN
    bold = TerminalUI.BOLD
    reset = TerminalUI.RESET

    print(f"\n{gold}{bold}⚡ ATHX 2027 • Master Athlete & Intelligence Hub{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}")
    print(f"  📁 Hub Location : {TerminalUI.GRAY}{AGY_DIR}{reset}")
    print(f"  🐍 Environment  : {TerminalUI.GRAY}{venv_py}{reset}")
    print(f"{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}\n")

    # Define execution pipeline steps
    steps = []
    if not args.skip_git:
        steps.append(("Pulling latest edits from GitHub", lambda: run_git_pull(AGY_DIR)))
    if not args.skip_health:
        steps.append(("Syncing Apple Health biometrics & sleep", lambda: run_health_sync(AGY_DIR, venv_py)))
    if not args.skip_garmin:
        steps.append(("Extracting Garmin strength, running & workouts", lambda: run_garmin_sync(AGY_DIR, venv_py)))
    if not args.skip_cal:
        steps.append(("Syncing tri-calendar schedule & open slots", lambda: run_calendar_sync(AGY_DIR, venv_py)))
    steps.append(("Rebuilding ATHX 2027 Athlete Headquarters", lambda: run_athlete_dashboard_build(AGY_DIR, venv_py)))
    if not args.no_push:
        steps.append(("Pushing updated datasets & dashboards to GitHub", lambda: run_git_push(AGY_DIR)))

    ui = TerminalUI(total_steps=len(steps))

    for idx, (label, func) in enumerate(steps, 1):
        ui.start_step(idx, label)
        status, msg = func()
        ui.finish_step(status=status, message=msg)

    total_time = time.time() - start_time
    workout_html = AGY_DIR / "garmin_workout.html"
    cal_html = AGY_DIR / "calendar_dashboard.html"

    print(f"\n{cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{reset}")
    print(f"  {TerminalUI.GREEN}✨ ATHX Orchestration Complete!{reset} {TerminalUI.GRAY}(Total time: {total_time:.1f}s){reset}")
